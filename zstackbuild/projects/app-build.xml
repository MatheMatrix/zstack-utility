<?xml version="1.0" encoding="UTF-8"?>
<project name="zstack app builder" basedir="..">
    <description>
        Configuration logic for APP builds
    </description>

    <!-- ================================================================== -->
    <!-- Target 1: Modify source code (called during 'prepare' phase)       -->
    <!-- Scope: ${zstackutility.source}                                     -->
    <!-- ================================================================== -->
    <target name="patch-source-code" if="APP_NAME">
        <echo message="====================================================================" />
        <echo message="[APP-SOURCE] Starting to patch zstack-utility source code, APP Name: ${APP_NAME}" />

        <!-- 1. Modify scripts in Installation directory -->
        <!-- Involves: install.sh, online_install.sh, bootstrap.j2 -->
        <echo message="Step 1: Patching Installation scripts..." />
        <replaceregexp flags="g" encoding="UTF-8" match="webapps/zstack" replace="webapps/${APP_NAME}">
             <fileset dir="${zstackutility.source}/installation" includes="bootstrap.j2, zstack-server" />
        </replaceregexp>


        <!-- Replace appname variable value in install and buildsystem scripts -->
        <echo message="Step 1.6: Patching appname variable value..." />
        <replaceregexp flags="g" encoding="UTF-8" match='app_name="zstack"' replace='app_name="${APP_NAME}"'>
             <fileset dir="${zstackutility.source}" includes="installation/install.sh, installation/online_install.sh, buildsystem/zstack, buildsystem/installwar.sh, zstackbuild/scripts/zstack" />
        </replaceregexp>

        <!-- 2. Modify zstackctl configurations -->
        <!-- Involves: collect_log_full.yaml, etc. -->
        <echo message="Step 2: Patching zstackctl configs..." />
        <replaceregexp flags="g" encoding="UTF-8" match="webapps/zstack" replace="webapps/${APP_NAME}">
             <fileset dir="${zstackutility.source}/zstackctl/zstackctl/conf" includes="collect_log*.yaml" />
        </replaceregexp>

        <!-- Rename WAR file reference in Buildsystem scripts -->
        <replaceregexp flags="g" encoding="UTF-8" match="zstack\.war" replace="${APP_NAME}.war">
             <fileset dir="${zstackutility.source}/buildsystem" includes="installwar.sh, zstack" />
        </replaceregexp>

        <echo message="[APP-SOURCE] Source code patching completed." />
    </target>


    <!-- ================================================================== -->
    <!-- Target 2: Modify files inside the WAR (called during 'pre-assemble') -->
    <!-- Scope: ${war.classpath.dir} (Java Resources)                       -->
    <!-- ================================================================== -->
    <target name="append-app-config-inner" if="APP_NAME">
        <echo message="====================================================================" />
        <echo message="[APP-INNER] Starting to modify internal WAR files..." />

        <!-- 1. Properties & XMLs -->
        <echo file="${war.classpath.dir}/zstack.properties" append="true">${line.separator}APP_NAME=${APP_NAME}
CloudBus.httpContextPath=${APP_NAME}
ExternalAPIAdapter.ZSClient.contextPath=${APP_NAME}</echo>

        <replaceregexp file="${war.classpath.dir}/zstack/conf/springConfigXml/RESTFacade.xml"
                       match="RESTFacade\.path:zstack" replace="RESTFacade.path:${APP_NAME}" byline="true" encoding="UTF-8" />

        <replaceregexp file="${war.dir}/META-INF/context.xml"
                       match='path="/zstack/static"' replace='path="/${APP_NAME}/static"' byline="true" encoding="UTF-8" />

        <replaceregexp file="${war.classpath.dir}/zstack/conf/app_config.xml"
                 match="&lt;propertiesFile&gt;zstack\.properties&lt;/propertiesFile&gt;"
                 replace="&lt;propertiesFile&gt;${APP_NAME}.properties&lt;/propertiesFile&gt;"
                 byline="true"
                 encoding="UTF-8" />

        <echo message="[APP-INNER] Internal WAR files modification completed." />
    </target>


</project>